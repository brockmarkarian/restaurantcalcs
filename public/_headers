# Content-hashed build output and fonts never change at the same URL
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images can be replaced in place, so cache for a week
/illustrations/*
  Cache-Control: public, max-age=604800

/og/*
  Cache-Control: public, max-age=604800
