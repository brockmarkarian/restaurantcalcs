---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Odo from '../components/Odo.astro';
import CalcIcon from '../components/CalcIcon.astro';
import DelightFigure from '../components/DelightFigure.astro';
import verdictLines from '../data/verdict-lines.json';

const calcs = [
  { slug: 'food-cost', title: 'Food Cost Percentage', desc: 'Compare food cost to revenue to spot menu margin issues.', time: '2 min', tag: 'Most used', viz: 'food-cost' },
  { slug: 'recipe-cost', title: 'Recipe & Plate Cost', desc: 'Build plate cost from ingredient quantities and prices.', time: '5 min', tag: null, viz: 'recipe-cost' },
  { slug: 'labor-cost', title: 'Labor Cost Percentage', desc: 'Track labor as a share of revenue across shifts.', time: '2 min', tag: null, viz: 'labor-cost' },
  { slug: 'tip-pool', title: 'Tip Pool & Tip Out', desc: 'Split tips fairly across roles by hours or points.', time: '3 min', tag: 'Popular', viz: 'tip-pool' },
  { slug: 'menu-pricing', title: 'Menu Pricing', desc: 'Reverse-engineer menu price from cost and target margin.', time: '2 min', tag: null, viz: 'menu-pricing' },
  { slug: 'liquor-pour-cost', title: 'Liquor Pour Cost', desc: 'Calculate pour cost % and benchmark against industry.', time: '3 min', tag: null, viz: 'liquor-pour-cost' },
  { slug: 'break-even', title: 'Break-Even Revenue', desc: 'Find revenue needed to cover fixed and variable costs.', time: '5 min', tag: null, viz: 'break-even' },
  { slug: 'inventory-variance', title: 'Inventory Variance', desc: 'Spot theft, waste, or counting errors in food inventory.', time: '4 min', tag: null, viz: 'inventory-variance' },
  { slug: 'prime-cost', title: 'Prime Cost', desc: 'Food + beverage + labor as % of revenue. The single number every operator should track weekly.', time: '2 min', tag: null, viz: 'prime-cost' },
  { slug: 'keg-cost', title: 'Draft Beer / Keg Cost', desc: 'Pour cost, cost per pour, profit per keg. Fixes the leakiest line item in any bar.', time: '2 min', viz: 'keg-cost' },
  { slug: 'no-show-deposit', title: 'No-Show & Deposit', desc: 'Cost of empty reserved seats. Suggested deposit, break-even no-show rate, annual recovery.', time: '3 min', viz: 'no-show' },
  { slug: 'menu-engineering', title: 'Menu Engineering', desc: 'Star / Plowhorse / Puzzle / Dog matrix. Classify items by margin and popularity.', time: '5 min', tag: null, viz: 'menu-eng' },
  { slug: 'delivery-profit', title: 'Delivery True-Profit', desc: 'DoorDash, UberEats, GrubHub commission stack vs your real cost. Net per platform order.', time: '4 min', viz: 'delivery' },
  { slug: 'catering-pricing', title: 'Catering Pricing', desc: 'Per-head price + service charge + suggested gratuity. Operator margin protected.', time: '5 min', viz: 'catering' },
  { slug: 'turnover-cost', title: 'Employee Turnover Cost', desc: 'Annual cost of replacement hires. Industry runs 75-130% turnover.', time: '3 min', viz: 'turnover' },
  { slug: 'fountain-cost', title: 'Fountain Drink / BIB Cost', desc: 'BIB yield + ice + free refills + cup cost. Real pour cost on soda.', time: '3 min', viz: 'fountain' },
];

const groups = [
  { name: 'Food and menu', slugs: ['food-cost', 'recipe-cost', 'menu-pricing', 'menu-engineering', 'inventory-variance', 'catering-pricing'] },
  { name: 'Bar', slugs: ['liquor-pour-cost', 'keg-cost', 'fountain-cost'] },
  { name: 'Staff and business', slugs: ['labor-cost', 'tip-pool', 'prime-cost', 'break-even', 'delivery-profit', 'turnover-cost', 'no-show-deposit'] },
];
const bySlug = Object.fromEntries(calcs.map((c) => [c.slug, c]));

// Most-used tiles are mini calculators. Defaults are each full calculator's
// example numbers; thresholds match the full pages (labor and prime use the
// casual-dining default those pages start on).
const lines = verdictLines as Record<string, any>;
const firstSentence = (t: string) => (t.match(/^[^.]*\./) || [t])[0];
type Band = { lean: number; healthy: number; watch: number };
const featured = [
  { slug: 'food-cost', label: 'Food cost %', a: { label: 'Food you bought', value: 7500 }, b: { label: 'Food sales', value: 25000 }, band: { lean: 28, healthy: 32, watch: 35 } as Band, pct: true },
  { slug: 'labor-cost', label: 'Labor cost %', a: { label: 'What staff cost you', value: 9000 }, b: { label: 'Sales', value: 30000 }, band: { lean: 28, healthy: 35, watch: 39 } as Band, pct: true },
  { slug: 'prime-cost', label: 'Prime cost', a: { label: 'Food, drink and labor', value: 18000 }, b: { label: 'Sales', value: 30000 }, band: { lean: 57, healthy: 65, watch: 70 } as Band, pct: true },
  { slug: 'tip-pool', label: 'Tip pool', a: { label: 'Total tips', value: 2400 }, b: { label: 'People splitting', value: 4 }, band: null, pct: false },
];
const tileResult = (f: (typeof featured)[number]) => {
  const v = f.b.value > 0 ? (f.pct ? (f.a.value / f.b.value) * 100 : f.a.value / f.b.value) : 0;
  const text = f.pct ? v.toFixed(1) : v.toFixed(2);
  let key = '', label = '';
  if (f.band) {
    if (v < f.band.lean) { key = 'healthy'; label = 'Lean'; }
    else if (v <= f.band.healthy) { key = 'healthy'; label = 'Healthy'; }
    else if (v <= f.band.watch) { key = 'watch'; label = 'Watch'; }
    else { key = 'high'; label = 'Critical'; }
  }
  return { v, text, key, label, quip: key ? firstSentence(lines[f.slug][key]) : '' };
};
const STAMP_COLOR: Record<string, string> = { healthy: '#b9d08a', watch: '#f2b544', high: '#f0a77a' };
const tileData = featured.map((f) => ({ slug: f.slug, band: f.band, pct: f.pct, lines: Object.fromEntries(Object.entries(lines[f.slug]).map(([k, t]) => [k, firstSentence(t as string)])) }));

// Calculator of the day: picked by build date (the site rebuilds daily)
const dayIndex = Math.floor(Date.now() / 86400000);
const todaySlug = calcs[dayIndex % calcs.length].slug;
const today = bySlug[todaySlug];
const todayLine = lines[todaySlug]?.healthy || '';
const todayTicket = String(dayIndex % 10000).padStart(4, '0');

const nowHome = new Date();
const recentPosts = (await getCollection('blog', ({ data }) => !data.draft && data.pubDate <= nowHome))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const faq = [
  {
    q: 'Are these calculators really free? What\'s the catch?',
    a: 'Free, no signup, no email gate, no upsell. The site runs on display advertising, you scroll past an ad placeholder. Every calculator runs in your browser; nothing is sent to a server. Close the tab and your inputs disappear.',
  },
  {
    q: 'Who built RestaurantCalcs and why should I trust the math?',
    a: 'Built by Brock Markarian, who spent 5 years behind a bar in California, bartender to GM. Every formula was audited against authoritative industry sources, <a href="https://pos.toasttab.com/blog/on-the-line/how-to-calculate-food-cost-percentage" target="_blank" rel="noopener">Toast</a>, Restaurant365, MarginEdge, the <a href="https://restaurant.org/" target="_blank" rel="noopener">National Restaurant Association</a>, the <a href="https://www.dol.gov/agencies/whd/fact-sheets/15-tipped-employees-flsa" target="_blank" rel="noopener">Department of Labor</a>, BinWise, BevSpot, the Culinary Institute of America. Sources are cited inline on each calculator page.',
  },
  {
    q: 'Why these calculators specifically? What\'s missing?',
    a: 'These are the metrics every indie restaurant runs every week: food cost %, recipe cost, labor cost % (with shift-by-shift mode), tip pool distribution, menu pricing, liquor pour cost, draft beer / keg cost, break-even revenue, inventory variance, prime cost, no-show deposit math, and menu engineering. They cover the full prime cost equation, the bar program, and the menu-strategy side. Catering pricing and schedule optimizer are next.',
  },
  {
    q: 'Can I use these for my restaurant\'s actual books?',
    a: 'Use them for sanity checks, weekly tracking, and quick decisions. They are educational tools, not a replacement for accounting software, payroll providers, or a labor attorney. The disclaimer on every page is real. Consult qualified professionals before making business decisions.',
  },
  {
    q: 'How accurate are the industry benchmark thresholds?',
    a: 'Benchmarks (e.g. food cost 28–32% healthy for full-service, labor cost 25–35% by concept type, liquor pour cost 18–24% for a full liquor program) are pulled from the most recent published industry sources. They\'re directional, not absolute. Your local market, vendor mix, and concept type all shift the right target for you.',
  },
  {
    q: 'Why does the tip pool calculator have legal warnings?',
    a: 'Because tip-pool violations carry six-figure FLSA penalties and the rules change. Federal law prohibits managers and supervisors from receiving pooled tips (FLSA §3(m)(2)(B), 2018). Tip-credit states restrict the pool to FOH only. The 2021 DOL final rule and the August 2024 Fifth Circuit vacatur of the 80/20/30 rule also matter. We surface the rules inline so operators can run the math without accidentally building an illegal policy.',
  },
];

const homepageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://restaurantcalcs.com/#webpage',
    url: 'https://restaurantcalcs.com/',
    name: 'RestaurantCalcs, Restaurant math, done right.',
    description: 'Free calculators for restaurant ops math. Built by a 5-year GM. Math shown on every result.',
    isPartOf: { '@id': 'https://restaurantcalcs.com/#website' },
    primaryImageOfPage: { '@type': 'ImageObject', url: 'https://restaurantcalcs.com/og/index.png' },
    inLanguage: 'en-US',
    author: { '@id': 'https://restaurantcalcs.com/#founder' },
    publisher: { '@id': 'https://restaurantcalcs.com/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'RestaurantCalcs, All calculators',
    description: 'Free calculators for everyday restaurant operations math.',
    numberOfItems: calcs.length,
    itemListElement: calcs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://restaurantcalcs.com/calculators/${c.slug}/`,
      name: c.title,
      description: c.desc,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': 'https://restaurantcalcs.com/#suite',
    name: 'RestaurantCalcs',
    description: 'Suite of free web-based calculators for restaurant operations: food cost, recipe cost, labor (with shift schedule mode), tip pool, menu pricing, liquor pour cost, draft beer / keg cost, break-even, inventory variance, prime cost, no-show deposit, and menu engineering.',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Restaurant Management',
    operatingSystem: 'Web',
    browserRequirements: 'Requires JavaScript',
    url: 'https://restaurantcalcs.com/',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    creator: { '@id': 'https://restaurantcalcs.com/#organization' },
    author: { '@id': 'https://restaurantcalcs.com/#founder' },
    isAccessibleForFree: true,
  },
];
---

<Layout schema={homepageSchema}>
  <section class="home-hero">
    <div class="container home-hero__inner">
      <div class="home-hero__copy">
        <h1 class="home-hero__title">Restaurant math, <span class="home-hero__accent">done right.</span></h1>
        <p class="home-hero__sub"><span class="home-roll"><span class="visually-hidden">16</span><Odo text="16" intro /></span> free calculators for everyday restaurant math. No accounts. No paywalls. The formula shown underneath every result so you can trust it and teach it.</p>
      </div>
      <form class="home-search" role="search" action="/calculators/" data-home-search>
        <label for="home-q" class="visually-hidden">What do you need to figure out?</label>
        <svg class="home-search__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <input id="home-q" class="home-search__input" type="search" name="q" placeholder="What do you need to figure out?" autocomplete="off" data-home-q />
      </form>
    </div>
  </section>

  <section class="container home-featured" aria-labelledby="home-featured-title">
    <h2 class="home-label" id="home-featured-title">Most used</h2>
    <div class="home-featured__grid">
      {featured.map((f) => {
        const r = tileResult(f);
        return (
          <div class="home-tile" data-tile={f.slug}>
            <div class="home-tile__head">
              <span class="home-tile__label">{f.label}</span>
              <span class="home-tile__fig"><DelightFigure slug={f.slug} value={f.pct ? r.v : undefined} count={f.pct ? undefined : f.b.value} /></span>
            </div>
            <div class="home-tile__result">
              <span class="visually-hidden" data-out>{f.pct ? `${r.text}%` : `$${r.text} each`}</span>
              <span class="home-tile__value">{!f.pct && <span class="home-tile__unit">$</span>}<Odo text={r.text} />{f.pct && <span class="home-tile__unit">%</span>}</span>
              {f.band && <span class="stamp home-tile__stamp" data-stamp style={`color:${STAMP_COLOR[r.key]}`}>{r.label}</span>}
            </div>
            <p class="home-tile__quip" data-quip>{f.pct ? r.quip : `Average per person, split ${f.b.value} ways.`}</p>
            <div class="home-tile__inputs">
              <label class="home-tile__field"><span>{f.a.label}</span><span class="home-tile__money">$<input type="text" inputmode="decimal" value={String(f.a.value)} data-in="a" aria-label={`${f.label}: ${f.a.label}`} /></span></label>
              <label class="home-tile__field"><span>{f.b.label}</span><span class="home-tile__money">{f.pct && '$'}<input type="text" inputmode="decimal" value={String(f.b.value)} data-in="b" aria-label={`${f.label}: ${f.b.label}`} /></span></label>
            </div>
            <a href={`/calculators/${f.slug}/`} class="home-tile__go">Open calculator <span aria-hidden="true">→</span></a>
          </div>
        );
      })}
    </div>
  </section>

  <section class="container home-all" id="calculators" aria-labelledby="home-all-title">
    <h2 class="home-all__title" id="home-all-title">All 16 calculators</h2>
    <div class="home-all__groups">
      {groups.map((g) => (
        <div class="home-group" data-home-group>
          <h3 class="home-label">{g.name}</h3>
          <ul class="home-group__list">
            {g.slugs.map((slug) => (
              <li data-home-item data-search={`${bySlug[slug].title} ${bySlug[slug].desc}`.toLowerCase()}>
                <a href={`/calculators/${slug}/`} class="home-row">
                  <span class="home-row__icon"><CalcIcon slug={slug} /></span>
                  <span class="home-row__text">
                    <span class="home-row__title">{bySlug[slug].title}</span>
                    <span class="home-row__desc">{bySlug[slug].desc}</span>
                  </span>
                  <span class="home-row__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="home-all__empty" data-home-empty hidden>No calculator matches that. Try "food", "labor" or "tips".</p>
  </section>

  <section class="container home-today" aria-labelledby="home-today-title">
    <div class="receipt home-today__ticket">
      <p class="home-today__head">RESTAURANTCALCS</p>
      <p class="home-today__sub"><span id="home-today-title">CALCULATOR OF THE DAY</span> · TICKET #{todayTicket}</p>
      <hr class="receipt__rule" />
      <div class="home-today__item">
        <span class="home-today__icon"><CalcIcon slug={todaySlug} size={32} /></span>
        <span>
          <span class="home-today__name">{today.title}</span>
          <span class="home-today__desc">{today.desc}</span>
        </span>
      </div>
      <hr class="receipt__rule" />
      <p class="home-today__line">"{todayLine}"</p>
      <hr class="receipt__rule" />
      <a class="home-today__open" href={`/calculators/${todaySlug}/`}>Open the calculator <span aria-hidden="true">→</span></a>
      <p class="home-today__foot">Math checked. Tip your bartender.</p>
    </div>
  </section>

  <section class="container home-trust">
    <div class="home-trust__card">
      <img class="home-trust__photo" src="/brock-markarian-240.webp" alt="Brock Markarian" width="96" height="96" loading="lazy" />
      <div class="home-trust__copy">
        <h2 class="home-trust__title">Five years behind the bar. Same site that serves you.</h2>
        <p class="home-trust__text">I started as a bartender in California and worked my way up to general manager. Ran the bar program and the nightclub for five years solid. Every calculator on this site was built around math I was running every week with a spreadsheet that crashed on phones, and every operator-story section is grounded in something I actually watched happen on the floor.</p>
        <p class="home-trust__text"><strong>No accounts. No email. No upsells. No catch.</strong> Just the answer with the math underneath, so you can teach it to your sous chef in thirty seconds.</p>
        <a href="/about/" class="home-trust__link">Read the full story <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  {recentPosts.length > 0 && (
    <section class="container home-posts" aria-labelledby="home-posts-title">
      <div class="home-posts__head">
        <h2 class="home-posts__title" id="home-posts-title">From the blog</h2>
        <a href="/blog/" class="home-posts__all">All posts <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-posts__grid">
        {recentPosts.map((post) => (
          <a href={`/blog/${post.id}/`} class="home-post">
            {post.data.tags && post.data.tags.length > 0 && <span class="home-post__tag">{post.data.tags[0]}</span>}
            <span class="home-post__title">{post.data.title}</span>
            <time class="home-post__date" datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="container home-faq" aria-labelledby="home-faq-title">
    <h2 class="home-faq__title" id="home-faq-title">Common questions</h2>
    <div class="home-faq__list">
      {faq.map((f) => (
        <details class="home-faq__item">
          <summary class="home-faq__q">
            <span>{f.q}</span>
            <span class="home-faq__plus" aria-hidden="true">+</span>
          </summary>
          <p class="home-faq__a" set:html={f.a}></p>
        </details>
      ))}
    </div>
  </section>
</Layout>

<script type="application/json" id="tile-data" set:html={JSON.stringify(tileData)}></script>

<script>
  // Most-used tiles: recompute as you type, roll the number, swap the stamp
  type Tile = { slug: string; band: { lean: number; healthy: number; watch: number } | null; pct: boolean; lines: Record<string, string> };
  const tileData: Tile[] = JSON.parse(document.getElementById('tile-data')?.textContent || '[]');
  const COLORS: Record<string, string> = { healthy: '#b9d08a', watch: '#f2b544', high: '#f0a77a' };
  const num = (el: HTMLInputElement | null) => parseFloat((el?.value || '').replace(/[^0-9.]/g, ''));
  const roll = (odo: HTMLElement, txt: string) => {
    const cols = [...odo.children] as HTMLElement[];
    if (cols.length !== txt.length || [...txt].some((ch, i) => /\d/.test(ch) !== !!cols[i].querySelector('.odo__strip'))) {
      odo.textContent = '';
      for (const ch of txt) {
        const col = document.createElement('span'); col.className = 'odo__col';
        if (/\d/.test(ch)) {
          const strip = document.createElement('span'); strip.className = 'odo__strip';
          for (let d = 0; d < 10; d++) { const n = document.createElement('span'); n.textContent = String(d); strip.appendChild(n); }
          col.appendChild(strip);
        } else col.textContent = ch;
        odo.appendChild(col);
      }
    }
    [...txt].forEach((ch, i) => {
      const strip = odo.children[i]?.querySelector('.odo__strip') as HTMLElement | null;
      if (strip) strip.style.transform = `translateY(-${Number(ch)}em)`;
    });
  };
  tileData.forEach((t) => {
    const tile = document.querySelector(`[data-tile="${t.slug}"]`) as HTMLElement | null;
    if (!tile) return;
    const a = tile.querySelector('[data-in="a"]') as HTMLInputElement | null;
    const b = tile.querySelector('[data-in="b"]') as HTMLInputElement | null;
    const odo = tile.querySelector('[data-odo]') as HTMLElement;
    const out = tile.querySelector('[data-out]') as HTMLElement;
    const stamp = tile.querySelector('[data-stamp]') as HTMLElement | null;
    const quip = tile.querySelector('[data-quip]') as HTMLElement;
    let last = stamp?.textContent || '';
    const update = () => {
      const x = num(a), y = num(b);
      if (!(x >= 0) || !(y > 0)) return;
      const v = t.pct ? (x / y) * 100 : x / y;
      const txt = t.pct ? v.toFixed(1) : v.toFixed(2);
      roll(odo, txt);
      out.textContent = t.pct ? `${txt}%` : `$${txt} each`;
      if (t.band && stamp) {
        const key = v < t.band.lean || v <= t.band.healthy ? 'healthy' : v <= t.band.watch ? 'watch' : 'high';
        const label = v < t.band.lean ? 'Lean' : key === 'healthy' ? 'Healthy' : key === 'watch' ? 'Watch' : 'Critical';
        stamp.style.color = COLORS[key];
        if (label !== last) { stamp.textContent = label; stamp.classList.remove('stamp--pop'); void stamp.offsetWidth; stamp.classList.add('stamp--pop'); last = label; }
        quip.textContent = t.lines[key];
        const pie = tile.querySelector('[data-dl="pie"]');
        if (pie) pie.setAttribute('stroke-dasharray', `${Math.min(100, Math.max(0, v))} 100`);
        const bar = tile.querySelector('[data-dl="bar"]');
        if (bar) bar.setAttribute('width', String(60 * Math.min(1, Math.max(0, v / 50))));
        const fill = tile.querySelector('[data-dl="fill"]') as SVGElement | null;
        if (fill) fill.style.transform = `scaleY(${Math.min(1, Math.max(0, v / 100))})`;
      } else {
        const n = Math.round(y);
        quip.textContent = `Average per person, split ${n} ways.`;
        const g = tile.querySelector('[data-dl="coins"]');
        if (g) {
          g.textContent = '';
          const count = Math.min(8, Math.max(1, n)), w = 60 / count;
          for (let i = 0; i < count; i++) {
            const h = 22 + ((i * 37) % 5) * 8;
            const r = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            r.setAttribute('x', String(30 + i * w + 1)); r.setAttribute('y', String(124 - h));
            r.setAttribute('width', String(Math.max(2, w - 2))); r.setAttribute('height', String(h));
            r.setAttribute('rx', '2'); r.setAttribute('fill', i % 2 ? '#c87500' : '#f2b544');
            g.appendChild(r);
          }
        }
      }
    };
    a?.addEventListener('input', update);
    b?.addEventListener('input', update);
  });

  // Homepage search: filters the calculator list, Enter opens the top match
  const form = document.querySelector('[data-home-search]') as HTMLFormElement | null;
  const input = document.querySelector('[data-home-q]') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-home-item]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-home-group]'));
  const empty = document.querySelector('[data-home-empty]') as HTMLElement | null;
  if (form && input) {
    const filter = () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      items.forEach((li) => {
        const hit = words.every((w) => (li.dataset.search || '').includes(w));
        li.hidden = !hit;
        if (hit) shown++;
      });
      groups.forEach((g) => { g.hidden = !g.querySelector('[data-home-item]:not([hidden])'); });
      if (empty) empty.hidden = shown > 0;
    };
    input.addEventListener('input', filter);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const first = items.find((li) => !li.hidden)?.querySelector('a');
      if (first && input.value.trim()) location.href = first.getAttribute('href') || '/calculators/';
      else document.getElementById('calculators')?.scrollIntoView({ behavior: 'smooth' });
    });
  }
</script>

