---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const title = 'Restaurant Operator Blog, Real Stories from a 5-Year Bar GM';
const description = 'Real operator stories, original case studies, and evidence-based ops analysis from independent restaurant managers and owners. Cited sources, lived experience.';

const now = new Date();
const allPosts = (await getCollection('blog', ({ data }) => !data.draft && data.pubDate <= now))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = allPosts[0];
const more = allPosts.slice(1);

// Topic chips: each post lands in the first topic its tags match
const TOPICS = [
  { key: 'bar', name: 'Bar', match: /pour cost|bar program|draft beer|beverage/i },
  { key: 'labor', name: 'Labor and tips', match: /labor|tip|turnover|scheduling|payroll|splh/i },
  { key: 'menu', name: 'Menu and pricing', match: /menu|pricing/i },
  { key: 'food', name: 'Food cost and inventory', match: /food cost|inventory|recipe|variance/i },
  { key: 'business', name: 'Business', match: /./ },
];
const topicOf = (tags: string[] = []) => TOPICS.find((t) => tags.some((tag) => t.match.test(tag))) || TOPICS[TOPICS.length - 1];
const usedTopics = TOPICS.filter((t) => allPosts.some((p) => topicOf(p.data.tags).key === t.key));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://restaurantcalcs.com/blog/#webpage',
    url: 'https://restaurantcalcs.com/blog/',
    name: title,
    description,
    isPartOf: { '@id': 'https://restaurantcalcs.com/#website' },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://restaurantcalcs.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://restaurantcalcs.com/blog/' },
    ],
  },
];

const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const fmtDateISO = (d: Date) => d.toISOString();

function readingMin(post: any): number {
  const wc = post.body?.split(/\s+/).length || 0;
  return Math.max(1, Math.ceil(wc / 220));
}
---

<Layout {title} {description} {schema} hideRails={true}>
  <article class="blog-index">
    <header class="blog-head">
      <nav class="blog-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Blog</span>
      </nav>
      <h1 class="blog-head__title">Real operator stories. Real numbers. No listicles.</h1>
      <p class="blog-head__lede">
        First-person analysis from independent restaurant managers, GMs, and owners. Specific incidents. What worked, what backfired. Cited industry sources. Written by a 5-year bar GM, not a content farm.
      </p>
      <div class="blog-head__byline">
        <img src="/brock-markarian-96.webp" alt="" width="40" height="40" class="blog-head__avatar" />
        <span><strong>Brock Markarian</strong> · Founder · 5 yrs Cosmos Taverna (Bartender → GM)</span>
      </div>
    </header>

    {featured && (
      <a href={`/blog/${featured.id}/`} class="blog-latest" data-post data-topic={topicOf(featured.data.tags).key}>
        {featured.data.heroImage && (
          <img class="blog-latest__img" src={featured.data.heroImage} srcset={`${featured.data.heroImage.replace('.webp', '-640.webp')} 640w, ${featured.data.heroImage} 1264w`} sizes="(max-width: 900px) 92vw, 520px" alt={`Editorial illustration for ${featured.data.title}`} width="1264" height="848" loading="eager" fetchpriority="high" />
        )}
        <div class="blog-latest__copy">
          <span class="blog-latest__meta">Latest · <time datetime={fmtDateISO(featured.data.pubDate)}>{fmtDate(featured.data.pubDate)}</time> · {readingMin(featured)} min read</span>
          <h2 class="blog-latest__title">{featured.data.title}</h2>
          <p class="blog-latest__desc">{featured.data.description}</p>
          <span class="blog-latest__cta">Read the full piece <span aria-hidden="true">→</span></span>
        </div>
      </a>
    )}

    {allPosts.length > 0 && (
      <section class="blog-list" aria-labelledby="blog-list-title">
        <h2 class="visually-hidden" id="blog-list-title">All posts</h2>
        <div class="blog-chips" role="group" aria-label="Filter by topic">
          <button type="button" class="blog-chip is-active" data-chip="all" aria-pressed="true">All <span class="blog-chip__n">{allPosts.length}</span></button>
          {usedTopics.map((t) => (
            <button type="button" class="blog-chip" data-chip={t.key} aria-pressed="false">{t.name} <span class="blog-chip__n">{allPosts.filter((p) => topicOf(p.data.tags).key === t.key).length}</span></button>
          ))}
        </div>
        <ul class="blog-rows">
          {more.map((post) => (
            <li data-post data-topic={topicOf(post.data.tags).key}>
              <a href={`/blog/${post.id}/`} class="blog-row">
                <span class="blog-row__meta">
                  <time datetime={fmtDateISO(post.data.pubDate)}>{fmtDate(post.data.pubDate)}</time>
                  <span class="blog-row__topic">{topicOf(post.data.tags).name}</span>
                </span>
                <span class="blog-row__title">{post.data.title}</span>
                <span class="blog-row__desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {allPosts.length === 0 && (
      <p class="blog-index__empty">First posts publishing soon. Check back this week.</p>
    )}

    <section class="blog-closer">
      <div class="blog-closer__inner">
        <p class="t-micro t-micro--saffron">Why this exists</p>
        <p class="blog-closer__copy">
          Most restaurant content online is either a paywalled SaaS pitch or AI-generated padding. This isn't. Every post here is written by a real operator about real operations, with citations, failure modes, and numbers you can verify. If something looks wrong, <a href="/contact/">email me</a>.
        </p>
        <p class="blog-closer__sources">
          Industry data points cross-referenced with the <a href="https://restaurant.org/research-and-media/research/economists-notebook/" target="_blank" rel="noopener nofollow">National Restaurant Association</a>, <a href="https://www.bls.gov/iag/tgs/iag722.htm" target="_blank" rel="noopener nofollow">BLS NAICS 722</a>, and <a href="https://www.dol.gov/agencies/whd/flsa/tips" target="_blank" rel="noopener nofollow">DOL FLSA tip-pool guidance</a>.
        </p>
      </div>
    </section>
  </article>
</Layout>

<script>
  // Topic chips filter the post list
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-chip]'));
  const posts = Array.from(document.querySelectorAll<HTMLElement>('[data-post]'));
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.chip;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', String(on));
      });
      posts.forEach((p) => { p.hidden = key !== 'all' && p.dataset.topic !== key; });
    });
  });
</script>

<style>
  .blog-index { max-width: 1080px; margin: 0 auto; padding: var(--space-8) var(--space-6) var(--space-20); }
  .blog-crumb { display: flex; gap: var(--space-2); font-size: 0.8125rem; color: var(--color-muted); margin-bottom: var(--space-3); }
  .blog-crumb a { color: var(--color-muted); }
  .blog-head__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 3vw + 0.9rem, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-heading);
    max-width: 820px;
  }
  .blog-head__lede { margin-top: var(--space-4); max-width: 680px; font-size: 1.0625rem; line-height: 1.6; color: var(--color-body); }
  .blog-head__byline { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-5); font-size: 0.875rem; color: var(--color-muted); }
  .blog-head__byline strong { color: var(--color-heading); }
  .blog-head__avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }

  .blog-latest {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-6);
    align-items: center;
    margin-top: var(--space-10);
    padding: var(--space-4);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    color: var(--color-heading);
    text-decoration: none;
  }
  .blog-latest[hidden] { display: none; }
  .blog-latest__img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius-xl); }
  .blog-latest__meta { font-size: 0.8125rem; color: var(--color-muted); }
  .blog-latest__title { margin-top: var(--space-2); font-family: var(--font-display); font-weight: 700; font-size: clamp(1.375rem, 1.2vw + 1rem, 1.875rem); line-height: 1.15; letter-spacing: -0.02em; }
  .blog-latest__desc { margin-top: var(--space-3); line-height: 1.6; color: var(--color-body); }
  .blog-latest__cta { display: inline-block; margin-top: var(--space-4); font-weight: 600; color: var(--color-saffron-text); }

  .blog-list { margin-top: var(--space-10); }
  .blog-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .blog-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid #dcd5c8;
    border-radius: 999px;
    background: var(--color-white);
    font: 500 0.875rem var(--font-body);
    color: var(--color-heading);
    cursor: pointer;
  }
  .blog-chip:hover { border-color: var(--color-saffron-text); }
  .blog-chip.is-active { background: #1c1a16; border-color: #1c1a16; color: #faf8f3; }
  .blog-chip__n { font-family: var(--font-mono); font-size: 0.75rem; opacity: 0.75; }

  .blog-rows { list-style: none; margin-top: var(--space-5); border-top: 1px solid var(--color-border); }
  .blog-rows li[hidden] { display: none; }
  .blog-row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 4px var(--space-6);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-heading);
    text-decoration: none;
  }
  .blog-row__meta { grid-row: span 2; display: flex; flex-direction: column; gap: 2px; font-size: 0.8125rem; color: var(--color-muted); }
  .blog-row__topic { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-saffron-text); }
  .blog-row__title { font-weight: 600; font-size: 1.0625rem; line-height: 1.35; }
  .blog-row__desc { font-size: 0.9375rem; line-height: 1.5; color: var(--color-body); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .blog-row:hover .blog-row__title { color: var(--color-saffron-text); }

  .blog-closer { margin-top: var(--space-16); }
  .blog-closer__inner { max-width: 720px; padding: var(--space-6); border: 1px solid var(--color-border); border-radius: 18px; background: var(--color-white); }
  .blog-closer__copy { margin-top: var(--space-3); font-size: 1.0625rem; line-height: 1.65; color: var(--color-body); }
  .blog-closer__sources { margin-top: var(--space-3); font-size: 0.875rem; line-height: 1.6; color: var(--color-muted); }
  .blog-closer a { color: var(--color-saffron-text); text-decoration: underline; }
  .blog-index__empty { margin-top: var(--space-8); }

  @media (max-width: 760px) {
    .blog-index { padding: var(--space-5) var(--space-4) var(--space-16); }
    .blog-latest { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); margin-top: var(--space-6); }
    .blog-row { grid-template-columns: minmax(0, 1fr); }
    .blog-row__meta { grid-row: auto; flex-direction: row; gap: var(--space-3); }
    .blog-chips { flex-wrap: nowrap; overflow-x: auto; margin: 0 calc(-1 * var(--space-4)); padding: 0 var(--space-4) 4px; scrollbar-width: none; }
    .blog-chip { flex: none; }
  }
</style>
