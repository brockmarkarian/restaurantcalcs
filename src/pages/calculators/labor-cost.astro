  .sched-row input, .sched-row select { background: transparent; border: none; padding: 6px 8px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 0.875rem; font-weight: 500; color: var(--color-heading); outline: none; min-width: 0; width: 100%; border-radius: 4px; }
  .sched-row input:focus, .sched-row select:focus { background: var(--color-cream); }
