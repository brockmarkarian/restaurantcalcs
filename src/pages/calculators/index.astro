---
import Layout from '../../layouts/Layout.astro';

const title = 'Free Restaurant Calculators, RestaurantCalcs';
const description = 'Free ops calculators: food cost, recipe, labor + shift, tip pool, pricing, pour cost, break-even, prime cost, keg, no-show, menu engineering. Math shown.';

const featured = { slug: 'food-cost', title: 'Food Cost Percentage', desc: 'Compare food cost to revenue. Industry healthy range 28–32% full-service. Quick mode + Detailed COGS w/ adjustments.', time: '2 min', tag: 'Most used', stat: '28–32%', statLabel: 'Healthy range' };

const groups = [
  {
    name: 'Cost calculators',
    eyebrow: '01',
    calcs: [
      { slug: 'recipe-cost', title: 'Recipe & Plate Cost', desc: 'Build plate cost from ingredients. Add unlimited rows.', time: '5 min' },
      { slug: 'liquor-pour-cost', title: 'Liquor Pour Cost', desc: 'Aggregate or per-drink. Bottle math + spillage.', time: '3 min' },
      { slug: 'keg-cost', title: 'Draft Beer / Keg Cost', desc: 'Cost per pour, pour cost %, profit per keg.', time: '2 min' },
      { slug: 'fountain-cost', title: 'Fountain Drink / BIB Cost', desc: 'BIB yield + ice + free refills + cup. Real fountain pour cost.', time: '3 min' },
    ],
  },
  {
    name: 'Pricing calculators',
    eyebrow: '02',
    calcs: [
      { slug: 'menu-pricing', title: 'Menu Pricing', desc: 'Price from plate cost + target. Charm rounding + prime cost.', time: '2 min' },
      { slug: 'break-even', title: 'Break-Even Revenue', desc: 'Fixed + variable. Margin of Safety + capacity check.', time: '5 min' },
      { slug: 'prime-cost', title: 'Prime Cost', desc: 'Food + bev + labor as % of revenue. The single ops metric.', time: '2 min' },
      { slug: 'menu-engineering', title: 'Menu Engineering', desc: 'Star / Plowhorse / Puzzle / Dog matrix. Per-item classification.', time: '5 min' },
      { slug: 'delivery-profit', title: 'Delivery True-Profit', desc: 'DoorDash, UberEats, GrubHub net per order + reverse-solve price.', time: '4 min' },
      { slug: 'catering-pricing', title: 'Catering Pricing', desc: 'Per-head + labor + rentals + service charge legal split.', time: '5 min' },
    ],
  },
  {
    name: 'Labor + tip calculators',
    eyebrow: '03',
    calcs: [
      { slug: 'labor-cost', title: 'Labor Cost Percentage', desc: 'Concept-aware thresholds + SPLH benchmarks.', time: '2 min' },
      { slug: 'tip-pool', title: 'Tip Pool & Tip Out', desc: 'Hours, points, equal, or tip-out %. FLSA flags.', time: '3 min' },
    ],
  },
  {
    name: 'Inventory calculators',
    eyebrow: '04',
    calcs: [
      { slug: 'inventory-variance', title: 'Inventory Variance', desc: 'Theoretical vs actual. Spot waste, theft, over-portioning.', time: '4 min' },
    ],
  },
  {
    name: 'Reservation & operations',
    eyebrow: '05',
    calcs: [
      { slug: 'no-show-deposit', title: 'No-Show & Deposit', desc: 'Cost of empty reservations. Deposit math + recovery.', time: '3 min' },
      { slug: 'turnover-cost', title: 'Employee Turnover Cost', desc: 'Annual cost of replacement hires. Hourly + salaried.', time: '3 min' },
    ],
  },
];

const allCalcs = [featured, ...groups.flatMap((g) => g.calcs)];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://restaurantcalcs.com/calculators/#webpage',
    url: 'https://restaurantcalcs.com/calculators/',
    name: title,
    description,
    isPartOf: { '@id': 'https://restaurantcalcs.com/#website' },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://restaurantcalcs.com/' },
      { '@type': 'ListItem', position: 2, name: 'Calculators', item: 'https://restaurantcalcs.com/calculators/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'RestaurantCalcs, All calculators',
    numberOfItems: allCalcs.length,
    itemListElement: allCalcs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://restaurantcalcs.com/calculators/${c.slug}/`,
      name: c.title,
      description: c.desc,
    })),
  },
];
---

<Layout {title} {description} {schema}>
  <article class="calcs">
    <header class="calcs__head">
      <nav class="calcs__crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Calculators</span>
      </nav>
      <h1 class="calcs__title">Restaurant math, <span class="calcs__accent">solved.</span></h1>
      <p class="calcs__lede">
        Free calculators for the operations math every independent restaurant runs every week. No accounts. No paywalls. The formula is shown underneath every result so you can trust it, and teach it to your sous in thirty seconds.
      </p>
      <form class="calcs__search" role="search" data-calcs-search>
        <label for="calcs-q" class="visually-hidden">Find a calculator</label>
        <svg class="calcs__search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <input id="calcs-q" class="calcs__search-input" type="search" name="q" placeholder="Find a calculator" autocomplete="off" data-calcs-q />
      </form>
    </header>

    <a href={`/calculators/${featured.slug}/`} class="calcs__featured" data-calcs-item data-search={`${featured.title} ${featured.desc}`.toLowerCase()}>
      <span class="calcs__featured-tag">{featured.tag}</span>
      <h2 class="calcs__featured-title">{featured.title}</h2>
      <p class="calcs__featured-desc">{featured.desc}</p>
      <span class="calcs__featured-stat"><span class="num">{featured.stat}</span> {featured.statLabel}</span>
      <span class="calcs__featured-go">Open the calculator <span aria-hidden="true">→</span></span>
    </a>

    <div class="calcs__groups">
      {groups.map((g) => (
        <section class="calcs__group" data-calcs-group>
          <h2 class="calcs__group-name">{g.name}</h2>
          <ul class="calcs__list">
            {g.calcs.map((c) => (
              <li data-calcs-item data-search={`${c.title} ${c.desc}`.toLowerCase()}>
                <a href={`/calculators/${c.slug}/`} class="calcs__row">
                  <span class="calcs__row-text">
                    <span class="calcs__row-title">{c.title}</span>
                    <span class="calcs__row-desc">{c.desc}</span>
                  </span>
                  <span class="calcs__row-time">{c.time}</span>
                  <span class="calcs__row-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p class="calcs__empty" data-calcs-empty hidden>No calculator matches that. Try "food", "labor" or "tips".</p>

    <section class="calc-closer">
      <p class="t-micro t-micro--saffron calc-closer__eyebrow">No SaaS pitch. Just math.</p>
      <p class="calc-closer__copy">
        <a href="https://pos.toasttab.com/resources" target="_blank" rel="noopener nofollow">Toast</a>, <a href="https://www.restaurant365.com/blog/" target="_blank" rel="noopener nofollow">Restaurant365</a>, <a href="https://www.marginedge.com/blog" target="_blank" rel="noopener nofollow">MarginEdge</a>every one of them has a free calculator behind an email gate. Independent operators don't need another sales funnel. They need a number, fast, on a phone, between rushes. That's all this is.
      </p>
      <p class="t-caption calc-closer__sources">
        Industry benchmarks cross-checked against the <a href="https://restaurant.org/research-and-media/research/economists-notebook/economic-indicators/" target="_blank" rel="noopener nofollow">National Restaurant Association</a> and <a href="https://www.bls.gov/iag/tgs/iag722.htm" target="_blank" rel="noopener nofollow">BLS NAICS 722 industry tables</a>.
      </p>
      <a href="/about/" class="calc-closer__link">Read the manifesto <span aria-hidden="true">→</span></a>
    </section>
  </article>
</Layout>

<script>
  // Filter the list as you type; ?q= from the header search pre-fills it
  const input = document.querySelector('[data-calcs-q]') as HTMLInputElement | null;
  const form = document.querySelector('[data-calcs-search]') as HTMLFormElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-calcs-item]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-calcs-group]'));
  const empty = document.querySelector('[data-calcs-empty]') as HTMLElement | null;
  if (input && form) {
    const filter = () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      items.forEach((el) => {
        const hit = words.every((w) => (el.dataset.search || '').includes(w));
        el.hidden = !hit;
        if (hit) shown++;
      });
      groups.forEach((g) => { g.hidden = !g.querySelector('[data-calcs-item]:not([hidden])'); });
      if (empty) empty.hidden = shown > 0;
    };
    const q = new URLSearchParams(location.search).get('q');
    if (q) { input.value = q; filter(); }
    input.addEventListener('input', filter);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const first = items.find((el) => !el.hidden);
      const href = first?.tagName === 'A' ? first.getAttribute('href') : first?.querySelector('a')?.getAttribute('href');
      if (href && input.value.trim()) location.href = href;
    });
  }
</script>

<style>
  .calcs { max-width: 1180px; margin: 0 auto; padding: var(--space-8) var(--space-6) var(--space-20); }
  .calcs__crumb { display: flex; gap: var(--space-2); font-size: 0.8125rem; color: var(--color-muted); margin-bottom: var(--space-3); }
  .calcs__crumb a { color: var(--color-muted); }
  .calcs__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 3.5vw + 0.75rem, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--color-heading);
  }
  .calcs__accent { color: var(--color-saffron-text); }
  .calcs__lede { margin-top: var(--space-4); max-width: 640px; font-size: 1.0625rem; line-height: 1.6; color: var(--color-body); }
  .calcs__search { position: relative; margin-top: var(--space-6); max-width: 460px; }
  .calcs__search-icon { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--color-muted); pointer-events: none; }
  .calcs__search-input {
    width: 100%;
    height: 56px;
    padding: 0 16px 0 46px;
    border: 1.5px solid #dcd5c8;
    border-radius: var(--radius-xl);
    background: var(--color-white);
    font: 1.0625rem var(--font-body);
    color: var(--color-heading);
  }
  .calcs__search-input:focus { outline: none; border-color: var(--color-saffron-text); box-shadow: 0 0 0 3px var(--alpha-saffron-focus); }

  .calcs__featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-8);
    padding: var(--space-6);
    border-radius: 18px;
    background: #1c1a16;
    color: #faf8f3;
    text-decoration: none;
  }
  .calcs__featured[hidden] { display: none; }
  .calcs__featured-tag { grid-column: 1 / -1; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #cfc7b8; }
  .calcs__featured-title { font-family: var(--font-display); font-weight: 700; font-size: 1.75rem; letter-spacing: -0.02em; color: #faf8f3; }
  .calcs__featured-desc { grid-column: 1; color: #e8e1d3; line-height: 1.55; max-width: 620px; }
  .calcs__featured-stat { grid-column: 2; grid-row: 2 / span 2; align-self: center; text-align: right; font-size: 0.8125rem; color: #cfc7b8; }
  .calcs__featured-stat .num { display: block; font-family: var(--font-mono); font-size: 2.5rem; line-height: 1; color: #f2b544; }
  .calcs__featured-go { grid-column: 1; color: #f2b544; font-weight: 600; }

  .calcs__groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-10) var(--space-12); margin-top: var(--space-12); align-items: start; }
  .calcs__group[hidden] { display: none; }
  .calcs__group-name { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); margin-bottom: var(--space-3); }
  .calcs__list { list-style: none; border-top: 1px solid var(--color-border); }
  .calcs__list li[hidden] { display: none; }
  .calcs__row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 60px;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-heading);
    text-decoration: none;
  }
  .calcs__row-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .calcs__row-title { font-weight: 600; }
  .calcs__row-desc { font-size: 0.8125rem; line-height: 1.4; color: var(--color-muted); }
  .calcs__row-time { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-muted); white-space: nowrap; }
  .calcs__row-arrow { color: var(--color-saffron-text); }
  .calcs__row:hover .calcs__row-title { color: var(--color-saffron-text); }
  .calcs__empty { margin-top: var(--space-4); color: var(--color-body); }

  .calc-closer { margin-top: var(--space-16); max-width: 720px; padding: var(--space-6); border: 1px solid var(--color-border); border-radius: 18px; background: var(--color-white); }
  .calc-closer__eyebrow { margin-bottom: var(--space-3); }
  .calc-closer__copy { font-size: 1.0625rem; line-height: 1.65; color: var(--color-body); }
  .calc-closer__copy a, .calc-closer__sources a { color: var(--color-saffron-text); text-decoration: underline; }
  .calc-closer__sources { margin-top: var(--space-3); }
  .calc-closer__link { display: inline-flex; align-items: center; min-height: 44px; margin-top: var(--space-2); font-weight: 600; color: var(--color-saffron-text); }

  @media (max-width: 760px) {
    .calcs { padding: var(--space-5) var(--space-4) var(--space-16); }
    .calcs__groups { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); margin-top: var(--space-8); }
    .calcs__featured { grid-template-columns: minmax(0, 1fr); padding: var(--space-5); }
    .calcs__featured-stat { grid-column: 1; grid-row: auto; text-align: left; }
    .calcs__row-time { display: none; }
  }
</style>
