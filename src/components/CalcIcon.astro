---
// Small line icon per calculator for lists and tiles. Uses currentColor.
interface Props { slug: string; size?: number }
const { slug, size = 28 } = Astro.props;
---
<svg class="calc-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {slug === 'food-cost' && (<><circle cx="12" cy="12" r="9" /><path d="M12 12V3a9 9 0 0 1 8.2 5.3Z" fill="currentColor" stroke="none" /></>)}
  {slug === 'recipe-cost' && (<><circle cx="12" cy="13" r="8" /><circle cx="12" cy="13" r="4.5" /><path d="M3 5l3 3M21 5l-3 3" /></>)}
  {slug === 'labor-cost' && (<><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M5 7h14M8 11h8M8 14h8M8 17h5" /></>)}
  {slug === 'tip-pool' && (<><path d="M6 6h12v12a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3Z" /><path d="M5 4h14M9 17v-4M12 17v-6M15 17v-3" /></>)}
  {slug === 'menu-pricing' && (<><path d="M3 12l9-9h8v8l-9 9a2 2 0 0 1-2.8 0L3 14.8a2 2 0 0 1 0-2.8Z" /><circle cx="16" cy="8" r="1.5" /></>)}
  {slug === 'liquor-pour-cost' && (<><path d="M10 2h4v5c2.5 1 4 3 4 6v7a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-7c0-3 1.5-5 4-6Z" /><path d="M6 14h12" /></>)}
  {slug === 'break-even' && (<><path d="M3 3v18h18" /><path d="M5 15L21 6M5 9l16 6" /></>)}
  {slug === 'inventory-variance' && (<><path d="M12 4v16M8 20h8M4 7h16" /><path d="M4 7l-2 6h4ZM20 7l-2 6h4Z" /></>)}
  {slug === 'prime-cost' && (<><rect x="8" y="3" width="8" height="18" rx="1.5" /><path d="M8 11h8" /><path d="M8 11h8v10H8Z" fill="currentColor" stroke="none" opacity=".35" /></>)}
  {slug === 'keg-cost' && (<><rect x="5" y="4" width="14" height="17" rx="3" /><path d="M5 9h14M5 16h14M10 2h4" /></>)}
  {slug === 'no-show-deposit' && (<><path d="M7 12h10V4M7 12V4M7 12v8M17 12v8" /><path d="M7 16h10" stroke-dasharray="2 2" /></>)}
  {slug === 'menu-engineering' && (<><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M12 3v18M3 12h18" /><circle cx="16.5" cy="7.5" r="1.8" fill="currentColor" /></>)}
  {slug === 'delivery-profit' && (<><path d="M5 8h14l-1.2 12H6.2Z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></>)}
  {slug === 'catering-pricing' && (<><path d="M4 16a8 8 0 0 1 16 0Z" /><path d="M2 16h20M12 6v2" /></>)}
  {slug === 'turnover-cost' && (<><rect x="4" y="3" width="16" height="18" rx="1" /><path d="M12 6v12M7 12h10" /></>)}
  {slug === 'fountain-cost' && (<><path d="M6 6h12l-1.5 15h-9Z" /><path d="M5 6h14M14 6l1-4" /><path d="M8.5 13h7" /></>)}
</svg>
